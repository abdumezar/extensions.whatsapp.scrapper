{
  "manifest_version": 3,
  "name": "Whatsapp Scrapper by abdumezar",
  "version": "0.2.0",
  "description": "Export the participants of the open WhatsApp Web group, community or broadcast list as a CSV. Nothing leaves your browser.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms", "notifications", "contextMenus"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "src/background/service-worker.js" },
  "action": {
    "default_title": "Whatsapp Scrapper by abdumezar",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "src/dashboard/index.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "export-open-chat": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" },
      "description": "Export the open WhatsApp chat"
    },
    "open-dashboard": {
      "suggested_key": { "default": "Ctrl+Shift+D", "mac": "Command+Shift+D" },
      "description": "Open the dashboard"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/page/store-adapter.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "src/lib/libphonenumber-max.js",
        "src/lib/phone.js",
        "src/lib/csv.js",
        "src/lib/xlsx.js",
        "src/lib/vcard.js",
        "src/content/dom-selectors.js",
        "src/content/dom-fallback.js",
        "src/content/content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
